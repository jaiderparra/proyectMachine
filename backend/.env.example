# Copie este archivo como .env y complete los valores. .env NO se versiona.

# Supabase: Project Settings → Database → Connection string → Session pooler
# Si se omite, la API usa una base PGlite local en backend/data/pglite (sin instalar nada).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=reservas

# Secreto para firmar los JWT (use un valor largo y aleatorio)
JWT_SECRET=cambie-este-valor

PORT=4000
CORS_ORIGIN=http://localhost:3000
